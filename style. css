* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, sans-serif;
    background: #f4f6f8;
    color: #222;
}

header {
    background: #24292f;
    color: white;
    text-align: center;
    padding: 35px 20px;
}

header h1 {
    margin-bottom: 10px;
}

main {
    width: 90%;
    max-width: 1100px;
    margin: 30px auto;
}

.search-section {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
}

.search-section input {
    flex: 1;
    padding: 14px;
    border: 1px solid #ccc;
    border-radius: 8px;
    font-size: 16px;
}

button {
    border: none;
    border-radius: 8px;
    padding: 12px 20px;
    cursor: pointer;
    background: #24292f;
    color: white;
}

button:hover {
    opacity: 0.85;
}

.controls {
    display: flex;
    gap: 15px;
    margin-bottom: 20px;
}

select {
    padding: 10px;
    border-radius: 6px;
    border: 1px solid #ccc;
}

.repo-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
}

.repo-card {
    background: white;
    padding: 20px;
    border-radius: 12px;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
}

.repo-card h2 {
    font-size: 20px;
    margin-bottom: 10px;
    color: #0969da;
}

.repo-card p {
    margin: 8px 0;
    color: #555;
}

.repo-card button {
    margin-top: 10px;
}

#status {
    text-align: center;
    margin: 20px;
    font-weight: bold;
}

.modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    justify-content: center;
    align-items: center;
    padding: 20px;
}

.modal-content {
    background: white;
    max-width: 600px;
    width: 100%;
    padding: 30px;
    border-radius: 12px;
    position: relative;
}

.close {
    position: absolute;
    right: 15px;
    top: 15px;
    background: #333;
}

@media (max-width: 600px) {

    .search-section {
        flex-direction: column;
    }

    .controls {
        flex-direction: column;
    }
}